{
    "name": "sayedsahin/bhitti-framework",
    "description": "A lightweight, simple and performance-first PHP framework.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Bhitti\\": "src/Bhitti/"
        },
        "files": [
            "src/Bhitti/Supports/helper.php"
        ]
    },
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "nikic/fast-route": "^1.3",
        "symfony/dotenv": "^7.4"
    },
    "suggest": {
        "twig/twig": "Required only when using the optional twig() view helper."
    }
}
